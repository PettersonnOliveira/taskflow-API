# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (compartilhando MySQL do nexus-store)
DB_NAME=taskflow_db
DB_USER=seu_usuario_mysql_do_nexus
DB_PASSWORD=sua_senha_mysql_do_nexus

# JWT Configuration
JWT_SECRET=sua_chave_secreta_jwt_taskflow_minimo_32_caracteres
JWT_EXPIRATION=86400000

# Usuário administrador padrão (opcional)
# Se ADMIN_PASSWORD estiver vazia, o seed é ignorado no startup.
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=
